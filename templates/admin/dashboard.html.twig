{% extends 'base.html.twig' %}

{% block title %}Gestion{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">Back-office</p>
    <h1 class="mb-4">Gestion de la boutique</h1>
    {{ include('admin/_nav.html.twig') }}

    <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
        <div class="col"><div class="counter"><span class="value">{{ revenue|price }}</span><span class="label">Chiffre d'affaires</span></div></div>
        <div class="col"><div class="counter"><span class="value">{{ counts.paid }}</span><span class="label">À expédier</span></div></div>
        <div class="col"><div class="counter"><span class="value">{{ counts.pending }}</span><span class="label">Attente de paiement</span></div></div>
        <div class="col"><div class="counter"><span class="value">{{ counts.delivered }}</span><span class="label">Livrées</span></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <h2 class="section-title mt-0"><span class="num">01</span> À expédier</h2>
            {% if to_ship is empty %}
                <p class="text-muted-blue">Rien à expédier pour le moment.</p>
            {% else %}
                {% for order in to_ship %}
                    <a href="{{ path('admin_order', {reference: order.reference}) }}" class="index-link">
                        <span><span class="code">{{ order.reference }}</span>{{ order.customer.fullName }} · {{ order.itemCount }} pièce{{ order.itemCount > 1 ? 's' }}</span>
                        <span class="text-nowrap">{{ order.totalCents|price }}</span>
                    </a>
                {% endfor %}
            {% endif %}
        </div>
        <div class="col-lg-5">
            <h2 class="section-title mt-0"><span class="num">02</span> Stock faible</h2>
            {% if low_stock is empty %}
                <p class="text-muted-blue">Tout est bien approvisionné.</p>
            {% else %}
                {% for product in low_stock %}
                    <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="index-link">
                        <span><span class="code">{{ product.reference }}</span>{{ product.name }}</span>
                        <span class="{{ product.stock == 0 ? 'text-danger' : '' }}">{{ product.stock == 0 ? 'épuisé' : product.stock ~ ' restant' ~ (product.stock > 1 ? 's') }}</span>
                    </a>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
