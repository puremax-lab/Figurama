{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <h1 class="mb-3">Administration</h1>
    {{ include('admin/_nav.html.twig') }}

    <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
        <div class="col"><div class="card card-body border-0 shadow-sm stat-card"><span class="display-6">{{ revenue|price }}</span><span class="text-body-secondary">Chiffre d'affaires</span></div></div>
        <div class="col"><div class="card card-body border-0 shadow-sm stat-card"><span class="display-6">{{ counts.paid }}</span><span class="text-body-secondary">À expédier</span></div></div>
        <div class="col"><div class="card card-body border-0 shadow-sm stat-card"><span class="display-6">{{ counts.pending }}</span><span class="text-body-secondary">En attente de paiement</span></div></div>
        <div class="col"><div class="card card-body border-0 shadow-sm stat-card"><span class="display-6">{{ counts.delivered }}</span><span class="text-body-secondary">Livrées</span></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Commandes à expédier</h2>
                    {% if to_ship is empty %}
                        <p class="text-body-secondary mb-0">Rien à expédier pour le moment.</p>
                    {% else %}
                        <ul class="list-group list-group-flush">
                            {% for order in to_ship %}
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span><a href="{{ path('admin_order', {reference: order.reference}) }}" class="fw-semibold">{{ order.reference }}</a><br><span class="small text-body-secondary">{{ order.customer.fullName }} · {{ order.itemCount }} article{{ order.itemCount > 1 ? 's' }}</span></span>
                                    <span class="text-nowrap">{{ order.totalCents|price }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Stock faible</h2>
                    {% if low_stock is empty %}
                        <p class="text-body-secondary mb-0">Tous les produits sont bien approvisionnés.</p>
                    {% else %}
                        <ul class="list-group list-group-flush">
                            {% for product in low_stock %}
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <a href="{{ path('admin_product_edit', {id: product.id}) }}">{{ product.icon }} {{ product.name }}</a>
                                    <span class="badge {{ product.stock == 0 ? 'text-bg-danger' : 'text-bg-warning' }}">{{ product.stock == 0 ? 'Épuisé' : product.stock ~ ' restant' ~ (product.stock > 1 ? 's') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
