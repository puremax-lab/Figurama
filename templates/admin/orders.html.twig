{% extends 'base.html.twig' %}

{% block title %}{{ 'Commandes'|trans }}{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">{{ 'Back-office'|trans }}</p>
    <h1 class="mb-4">{{ 'Commandes'|trans }}</h1>
    {{ include('admin/_nav.html.twig') }}

    <div class="d-flex flex-nowrap overflow-auto gap-2 mb-4">
        <a href="{{ path('admin_orders') }}" class="btn btn-sm text-nowrap {{ current_status ? 'btn-outline-light' : 'btn-primary' }}">{{ 'Toutes'|trans }}</a>
        {% for status in enum('App\\Entity\\OrderStatus').cases() %}
            <a href="{{ path('admin_orders', {statut: status.value}) }}" class="btn btn-sm text-nowrap {{ current_status == status ? 'btn-primary' : 'btn-outline-light' }}">{{ status.label|trans }} ({{ counts[status.value] }})</a>
        {% endfor %}
    </div>

    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th class="ps-3">{{ 'Référence'|trans }}</th><th>{{ 'Client'|trans }}</th><th>{{ 'Date'|trans }}</th><th class="text-end">{{ 'Total'|trans }}</th><th class="pe-3">{{ 'Statut'|trans }}</th></tr></thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td class="ps-3"><a href="{{ path('admin_order', {reference: order.reference}) }}">{{ order.reference }}</a></td>
                            <td>{{ order.customer.fullName }}</td>
                            <td class="text-nowrap">{{ order.createdAt|format_date('medium', locale: app.request.locale) }}</td>
                            <td class="text-end text-nowrap">{{ order.totalCents|price }}</td>
                            <td class="pe-3">{{ include('_partials/_status.html.twig', {status: order.status}) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted-blue py-4">{{ 'Aucune commande.'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
