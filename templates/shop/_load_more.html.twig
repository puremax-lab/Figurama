{# Without JavaScript this is a normal link to the next page; with it, the next page loads by itself #}
{% if next_url %}
    <a href="{{ next_url }}" class="btn btn-outline-light load-more" data-load-more data-target="#catalogue" data-label="{{ 'Charger la suite'|trans }}" data-loading="{{ 'Chargement…'|trans }}">{{ 'Charger la suite'|trans }}</a>
{% endif %}
