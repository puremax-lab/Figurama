{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}
{% block description %}{{ product.description|length > 155 ? product.description|slice(0, 154) ~ '…' : product.description }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('app_shop') }}">Boutique</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_shop', {categorie: product.category.slug}) }}">{{ product.category.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="row g-4 g-lg-5 mb-5">
        <div class="col-md-6">
            <div class="product-visual product-visual-large shadow-sm" style="background: {{ product.color }}" aria-hidden="true">{{ product.icon }}</div>
        </div>
        <div class="col-md-6">
            <span class="badge text-bg-light mb-2">{{ product.category.icon }} {{ product.category.name }}</span>
            <h1>{{ product.name }}</h1>
            <p class="fs-3 fw-bold mb-3">{{ product.priceCents|price }}</p>
            <p>{{ product.description }}</p>

            {% if product.available %}
                <p class="{{ product.lowStock ? 'text-warning-emphasis' : 'text-success' }} fw-semibold">
                    <i class="bi bi-check-circle"></i>
                    {{ product.lowStock ? 'Plus que ' ~ product.stock ~ ' en stock' : 'En stock' }}
                </p>
                <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                    <label for="quantity" class="visually-hidden">Quantité</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ min(product.stock, 10) }}" class="form-control qty-input">
                    <button class="btn btn-primary btn-lg flex-grow-1"><i class="bi bi-bag-plus"></i> Ajouter au panier</button>
                </form>
            {% else %}
                <p class="text-body-secondary fw-semibold"><i class="bi bi-x-circle"></i> Épuisé pour le moment</p>
                <button class="btn btn-secondary btn-lg w-100" disabled>Indisponible</button>
            {% endif %}

            <ul class="list-unstyled small text-body-secondary mt-4 mb-0">
                <li><i class="bi bi-truck me-2"></i>Livraison offerte en 3 à 5 jours ouvrés</li>
                <li><i class="bi bi-arrow-return-left me-2"></i>Retour gratuit pendant 30 jours</li>
                <li><i class="bi bi-shield-check me-2"></i>Paiement sécurisé par Stripe</li>
            </ul>
        </div>
    </div>

    {% if similar %}
        <h2 class="h4 mb-3">Dans la même catégorie</h2>
        <div class="row row-cols-2 row-cols-lg-4 g-3">
            {% for product in similar %}
                <div class="col">{{ include('_partials/_product_card.html.twig') }}</div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
