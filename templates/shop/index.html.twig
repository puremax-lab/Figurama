{% extends 'base.html.twig' %}

{% block title %}{{ current_category ? current_category.name : 'Boutique' }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="mb-0">{{ current_category ? current_category.icon ~ ' ' ~ current_category.name : 'Toutes les figurines' }}</h1>
            <p class="text-body-secondary mb-0">{{ total }} figurine{{ total > 1 ? 's' }}</p>
        </div>
    </div>

    <form method="get" class="card card-body border-0 shadow-sm mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="q" class="form-label small">Recherche</label>
                <input type="search" id="q" name="q" value="{{ query }}" class="form-control" placeholder="Dragon, robot…">
            </div>
            <div class="col-6 col-md-3">
                <label for="categorie" class="form-label small">Catégorie</label>
                <select id="categorie" name="categorie" class="form-select">
                    <option value="">Toutes</option>
                    {% for item in categories %}
                        <option value="{{ item.category.slug }}" {{ current_category and current_category.id == item.category.id ? 'selected' }}>{{ item.category.name }} ({{ item.products }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="tri" class="form-label small">Trier par</label>
                <select id="tri" name="tri" class="form-select">
                    {% for value, label in {'nouveautes': 'Nouveautés', 'prix-croissant': 'Prix croissant', 'prix-decroissant': 'Prix décroissant', 'nom': 'Nom'} %}
                        <option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2 align-items-center">
                <div class="form-check me-auto">
                    <input class="form-check-input" type="checkbox" id="dispo" name="dispo" value="1" {{ in_stock ? 'checked' }}>
                    <label class="form-check-label small" for="dispo">En stock</label>
                </div>
                <button class="btn btn-dark">Filtrer</button>
            </div>
        </div>
    </form>

    {% if total %}
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            {% for product in products %}
                <div class="col">{{ include('_partials/_product_card.html.twig') }}</div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-5 text-body-secondary">
            <p class="fs-1 mb-2" aria-hidden="true">🔍</p>
            <p>Aucune figurine ne correspond à votre recherche.</p>
            <a href="{{ path('app_shop') }}" class="btn btn-outline-dark">Voir toute la boutique</a>
        </div>
    {% endif %}

    {% if pages > 1 %}
        <nav class="mt-4" aria-label="Pages">
            <ul class="pagination justify-content-center">
                {% for p in 1..pages %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('app_shop', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
