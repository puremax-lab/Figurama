{% extends 'base.html.twig' %}

{% block title %}{{ current_category ? current_category.name : 'Catalogue' }}{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">{{ current_category ? 'Série ' ~ current_category.code : 'Catalogue général' }}</p>
    <h1 class="mb-1">{{ current_category ? current_category.name : 'Toutes les pièces' }}</h1>
    <p class="text-muted-blue mb-4">{{ total }} pièce{{ total > 1 ? 's' }} trouvée{{ total > 1 ? 's' }}</p>

    <form method="get" class="panel mb-5">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="q" class="form-label">Recherche</label>
                <input type="search" id="q" name="q" value="{{ query }}" class="form-control" placeholder="dragon, robot, bronze…">
            </div>
            <div class="col-6 col-md-3">
                <label for="categorie" class="form-label">Série</label>
                <select id="categorie" name="categorie" class="form-select">
                    <option value="">Toutes</option>
                    {% for item in categories %}
                        <option value="{{ item.category.slug }}" {{ current_category and current_category.id == item.category.id ? 'selected' }}>{{ item.category.code }} · {{ item.category.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="tri" class="form-label">Tri</label>
                <select id="tri" name="tri" class="form-select">
                    {% for value, label in {'nouveautes': 'Nouveautés', 'prix-croissant': 'Prix ↑', 'prix-decroissant': 'Prix ↓', 'nom': 'Nom'} %}
                        <option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-3 align-items-center">
                <div class="form-check me-auto">
                    <input class="form-check-input" type="checkbox" id="dispo" name="dispo" value="1" {{ in_stock ? 'checked' }}>
                    <label class="form-check-label small" for="dispo">En stock</label>
                </div>
                <button class="btn btn-primary">Filtrer</button>
            </div>
        </div>
    </form>

    {% if total %}
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4" id="catalogue">
            {% for product in products %}
                <div class="col">{{ include('_partials/_product_card.html.twig') }}</div>
            {% endfor %}
        </div>
    {% else %}
        <div class="panel text-center py-5">
            <p class="display fs-3 mb-2">Aucune pièce</p>
            <p class="text-muted-blue">Rien ne correspond à cette recherche.</p>
            <a href="{{ path('app_shop') }}" class="btn btn-outline-light">Tout le catalogue</a>
        </div>
    {% endif %}

    {{ include('shop/_load_more.html.twig') }}
{% endblock %}
