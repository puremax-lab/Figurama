{% extends 'base.html.twig' %}

{% block body %}
    <section class="hero p-4 p-md-5 mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="text-uppercase fw-bold small text-primary mb-2">Figurines de collection</p>
                <h1 class="display-5 fw-bold">Des héros, des dragons et des robots pour vos étagères.</h1>
                <p class="lead text-body-secondary">Des figurines peintes à la main, livrées gratuitement en Belgique, en France, au Luxembourg et aux Pays-Bas.</p>
                <a href="{{ path('app_shop') }}" class="btn btn-primary btn-lg">Découvrir la boutique</a>
            </div>
            <div class="col-lg-5 text-center hero-icons" aria-hidden="true">🐉🤖<br>🦊🦸</div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="h4 mb-3">Catégories</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
            {% for item in categories %}
                <div class="col">
                    <a href="{{ path('app_shop', {categorie: item.category.slug}) }}" class="category-chip shadow-sm h-100">
                        <span aria-hidden="true">{{ item.category.icon }}</span>
                        <span><strong class="d-block">{{ item.category.name }}</strong><span class="small text-body-secondary">{{ item.products }} figurines</span></span>
                    </a>
                </div>
            {% endfor %}
        </div>
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h2 class="h4 mb-0">Coups de cœur</h2>
            <a href="{{ path('app_shop') }}">Tout voir <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row row-cols-2 row-cols-lg-4 g-3">
            {% for product in featured %}
                <div class="col">{{ include('_partials/_product_card.html.twig') }}</div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
