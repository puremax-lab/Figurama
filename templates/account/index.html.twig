{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">{{ app.user.email }}</p>
    <h1 class="mb-4">Bonjour {{ app.user.firstName }}</h1>

    <h2 class="section-title text-start mt-4">Mes commandes</h2>
    {% if orders is empty %}
        <div class="panel text-center py-4">
            <p class="text-soft mb-3">Vous n'avez pas encore passé de commande.</p>
            <a href="{{ path('app_shop') }}" class="btn btn-primary">Découvrir la boutique</a>
        </div>
    {% else %}
        <div class="panel p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th class="ps-3">Référence</th><th>Date</th><th>Articles</th><th>Total</th><th class="pe-3">Statut</th></tr></thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td class="ps-3"><a href="{{ path('app_account_order', {reference: order.reference}) }}">{{ order.reference }}</a></td>
                                <td class="text-nowrap">{{ order.createdAt|format_date('medium', locale: 'fr') }}</td>
                                <td>{{ order.itemCount }}</td>
                                <td class="text-nowrap">{{ order.totalCents|price }}</td>
                                <td class="pe-3">{{ include('_partials/_status.html.twig', {status: order.status}) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
