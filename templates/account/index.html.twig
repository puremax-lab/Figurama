{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <h1>Bonjour {{ app.user.firstName }}</h1>
    <p class="text-body-secondary">{{ app.user.email }}</p>

    <h2 class="h4 mt-4 mb-3">Mes commandes</h2>
    {% if orders is empty %}
        <div class="card card-body border-0 shadow-sm text-center">
            <p class="text-body-secondary mb-2">Vous n'avez pas encore passé de commande.</p>
            <div><a href="{{ path('app_shop') }}" class="btn btn-primary">Découvrir la boutique</a></div>
        </div>
    {% else %}
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Référence</th><th>Date</th><th>Articles</th><th>Total</th><th>Statut</th></tr></thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td><a href="{{ path('app_account_order', {reference: order.reference}) }}" class="fw-semibold">{{ order.reference }}</a></td>
                                <td class="text-nowrap">{{ order.createdAt|format_date('medium', locale: 'fr') }}</td>
                                <td>{{ order.itemCount }}</td>
                                <td class="text-nowrap">{{ order.totalCents|price }}</td>
                                <td>{{ include('_partials/_status.html.twig', {status: order.status}) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
