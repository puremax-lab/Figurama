{% extends 'base.html.twig' %}

{% block title %}{{ 'Commande %reference%'|trans({'%reference%': order.reference}) }}{% endblock %}

{% block body %}
    <a href="{{ path('app_account') }}" class="small">{{ '← Mes commandes'|trans }}</a>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 my-3">
        <h1 class="mb-0">{{ order.reference }}</h1>
        {{ include('_partials/_status.html.twig', {status: order.status}) }}
    </div>

    {% if order.status.value == 'pending' %}
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-3">
            <span class="me-auto">{{ 'Commande non payée : les pièces restent réservées pour vous.'|trans }}</span>
            <a href="{{ path('app_payment', {reference: order.reference}) }}" class="btn btn-sm btn-primary">{{ 'Payer maintenant'|trans }}</a>
            <form method="post" action="{{ path('app_account_order_cancel', {reference: order.reference}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.reference) }}">
                <button class="btn btn-sm btn-dark">{{ 'Annuler la commande'|trans }}</button>
            </form>
        </div>
    {% endif %}

    {{ include('_partials/_order_summary.html.twig') }}
{% endblock %}
