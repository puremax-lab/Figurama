<!doctype html>
<html lang="fr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Figurines à l'échelle{% endblock %} · Figurama</title>
    <meta name="description" content="{% block description %}Figurama, atelier de figurines de collection : chaque pièce est référencée, mesurée et peinte à la main.{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 fill=%22%23123a6d%22/><path d=%22M6 26V6h14M6 16h10%22 stroke=%22%23ffd23f%22 stroke-width=%224%22 fill=%22none%22/></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<div class="announce">
    <div class="container announce-inner">
        <span>Livraison offerte BE · FR · LU · NL</span>
        <span class="d-none d-sm-inline">Retour gratuit 30 jours</span>
        <span class="d-none d-md-inline">Paiement sécurisé Stripe</span>
        <span class="d-none d-lg-inline">Expédition sous 48 h</span>
    </div>
</div>
<nav class="navbar navbar-expand-md topbar py-3">
    <div class="container">
        <a class="brand me-4" href="{{ path('app_home') }}">FIGURAMA<small>FIGURINES DE COLLECTION · PEINTES À LA MAIN</small></a>
        <a href="{{ path('app_cart') }}" class="btn btn-primary btn-sm ms-auto me-3 d-md-none" data-cart-open>Bon [<span data-cart-count>{{ cart_count() }}</span>]</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link {{ app.current_route == 'app_shop' ? 'active' }}" href="{{ path('app_shop') }}">Catalogue</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link {{ app.current_route starts with 'admin' ? 'active' }}" href="{{ path('admin_dashboard') }}">Gestion</a></li>
                {% endif %}
            </ul>
            <form action="{{ path('app_shop') }}" method="get" class="header-search my-3 my-md-0 me-md-3" role="search">
                <label for="header-q" class="visually-hidden">Rechercher une figurine</label>
                <input type="search" id="header-q" name="q" value="{{ app.request.query.get('q') }}" class="form-control form-control-sm" placeholder="Rechercher : dragon, robot…">
            </form>
            <ul class="navbar-nav align-items-md-center gap-md-3">
                {% if app.user %}
                    <li class="nav-item"><a class="nav-link {{ app.current_route starts with 'app_account' ? 'active' }}" href="{{ path('app_account') }}">Compte : {{ app.user.firstName }}</a></li>
                    <li class="nav-item">
                        <form method="post" action="{{ path('app_logout') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="btn btn-link nav-link px-0">Déconnexion</button>
                        </form>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Connexion</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}">Inscription</a></li>
                {% endif %}
                <li class="nav-item d-none d-md-block">
                    <a href="{{ path('app_cart') }}" class="btn btn-primary btn-sm" data-cart-open>Bon de commande [<span data-cart-count>{{ cart_count() }}</span>]</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1 py-4 py-md-5">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="footer mt-auto">
    <div class="container py-4 d-flex flex-column flex-md-row justify-content-between gap-3">
        <div>
            <a class="footer-brand" href="{{ path('app_home') }}">FIGURAMA</a>
            <p class="mb-0 mt-1">PROJET PORTFOLIO DE PUREMAX-LAB</p>
            <p class="mb-0">BOUTIQUE DE DÉMONSTRATION · AUCUN COLIS N'EST EXPÉDIÉ · PHOTOS UNSPLASH</p>
        </div>
        <nav class="footer-links d-flex flex-wrap align-items-md-end gap-3" aria-label="Liens du pied de page">
            <a href="{{ path('app_shop') }}">Catalogue</a>
            <a href="https://github.com/puremax-lab/Figurama" target="_blank" rel="noopener">Code source ↗</a>
            <a href="https://github.com/puremax-lab" target="_blank" rel="noopener">GitHub puremax-lab ↗</a>
            <a href="{{ path('app_legal') }}">Mentions légales</a>
            <span>© {{ 'now'|date('Y') }}</span>
        </nav>
    </div>
</footer>
{# Side drawer filled by assets/app.js after a quick add #}
<aside class="offcanvas offcanvas-end cart-drawer" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerTitle" data-url="{{ path('app_cart_drawer') }}">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="cartDrawerTitle">Bon de commande</h2>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <p class="cart-drawer-message" data-cart-message role="status"></p>
    <div class="offcanvas-body" data-cart-drawer-body></div>
</aside>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous" defer></script>
</body>
</html>
