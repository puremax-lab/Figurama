<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Figurines de collection{% endblock %} · Figurama</title>
    <meta name="description" content="{% block description %}Figurama, petite boutique de figurines de collection choisies et peintes avec soin.{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><circle cx=%2216%22 cy=%2216%22 r=%2216%22 fill=%22%23f6e6e1%22/><text x=%2216%22 y=%2222%22 font-family=%22Georgia%22 font-style=%22italic%22 font-size=%2218%22 text-anchor=%22middle%22 fill=%22%239e6a63%22>F</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,600&family=Jost:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-md topbar py-3">
    <div class="container">
        <a class="brand me-5" href="{{ path('app_home') }}">Figurama</a>
        <a href="{{ path('app_cart') }}" class="cart-link ms-auto me-3 d-md-none">Panier ({{ cart_count() }})</a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto gap-md-3">
                <li class="nav-item"><a class="nav-link {{ app.current_route == 'app_shop' ? 'active' }}" href="{{ path('app_shop') }}">Boutique</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link {{ app.current_route starts with 'admin' ? 'active' }}" href="{{ path('admin_dashboard') }}">Atelier</a></li>
                {% endif %}
            </ul>
            <ul class="navbar-nav align-items-md-center gap-md-4">
                {% if app.user %}
                    <li class="nav-item"><a class="nav-link {{ app.current_route starts with 'app_account' ? 'active' }}" href="{{ path('app_account') }}">{{ app.user.firstName }}</a></li>
                    <li class="nav-item">
                        <form method="post" action="{{ path('app_logout') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="btn btn-link nav-link">Déconnexion</button>
                        </form>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Connexion</a></li>
                {% endif %}
                <li class="nav-item d-none d-md-block"><a href="{{ path('app_cart') }}" class="cart-link">Panier ({{ cart_count() }})</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1 py-4 py-md-5">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="footer mt-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-5">
                <a class="brand" href="{{ path('app_home') }}">Figurama</a>
                <p class="mt-3 mb-0">Petite boutique de figurines de collection, peintes à la main et envoyées avec soin.</p>
            </div>
            <div class="col-6 col-md-3 offset-md-1">
                <h3 class="footer-title">Boutique</h3>
                <ul class="footer-links">
                    <li><a href="{{ path('app_shop') }}">Toutes les figurines</a></li>
                    <li><a href="{{ path('app_shop', {categorie: 'fantasy'}) }}">Fantasy</a></li>
                    <li><a href="{{ path('app_shop', {categorie: 'retro-futur'}) }}">Rétro-futur</a></li>
                    <li><a href="{{ path('app_shop', {categorie: 'curiosites'}) }}">Curiosités</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3">
                <h3 class="footer-title">Compte</h3>
                <ul class="footer-links">
                    <li><a href="{{ path('app_account') }}">Mes commandes</a></li>
                    <li><a href="{{ path('app_cart') }}">Panier</a></li>
                    <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>Boutique de démonstration : aucune commande n'est expédiée.</span>
            <span>Photos : Unsplash</span>
        </div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous" defer></script>
</body>
</html>
