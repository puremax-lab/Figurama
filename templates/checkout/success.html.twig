{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
    <div class="text-center py-4">
        {% if order.status.value == 'pending' %}
            <p class="eyebrow">En attente</p>
            <h1>Paiement en cours de validation</h1>
            <p class="text-soft mt-3">Stripe n'a pas encore confirmé le paiement de la commande {{ order.reference }}. Cette page sera à jour dans quelques instants.</p>
        {% else %}
            <p class="mb-3"><span class="status status-paid">Paiement reçu</span></p>
            <h1>Merci pour votre commande</h1>
            <p class="text-soft mt-3">Commande <strong>{{ order.reference }}</strong> · {{ order.totalCents|price }}<br>Préparation en cours, expédition vers {{ order.shippingCity }} sous 48 h.</p>
        {% endif %}
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a href="{{ path('app_account_order', {reference: order.reference}) }}" class="btn btn-primary">Voir la commande</a>
            <a href="{{ path('app_shop') }}" class="btn btn-outline">Retour à la boutique</a>
        </div>
    </div>
{% endblock %}
