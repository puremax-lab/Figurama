{% extends 'base.html.twig' %}

{% block title %}{{ 'Commande confirmée'|trans }}{% endblock %}

{% block body %}
    <div class="text-center py-4">
        {% if order.status.value == 'pending' %}
            <p class="eyebrow">{{ 'En attente'|trans }}</p>
            <h1>{{ 'Paiement en cours de validation'|trans }}</h1>
            <p class="text-muted-blue mt-3">{{ "Stripe n'a pas encore confirmé le paiement de la commande %reference%. Cette page sera à jour dans quelques instants."|trans({'%reference%': order.reference}) }}</p>
        {% else %}
            <p class="mb-4"><span class="sticker sticker-big">{{ 'Payé'|trans }}</span></p>
            <h1>{{ 'Merci pour votre commande'|trans }}</h1>
            <p class="text-muted-blue mt-3">{{ 'Commande'|trans }} <strong class="text-white">{{ order.reference }}</strong> · {{ order.totalCents|price }}<br>{{ "Préparation à l'atelier, expédition vers %city% sous 48 h."|trans({'%city%': order.shippingCity}) }}</p>
        {% endif %}
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a href="{{ path('app_account_order', {reference: order.reference}) }}" class="btn btn-primary">{{ 'Voir la commande'|trans }}</a>
            <a href="{{ path('app_shop') }}" class="btn btn-outline-light">{{ 'Retour au catalogue'|trans }}</a>
        </div>
    </div>
{% endblock %}
