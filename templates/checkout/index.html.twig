{% extends 'base.html.twig' %}

{% block title %}Expédition{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">Étape 1 sur 2</p>
    <h1 class="mb-4">Adresse d'expédition</h1>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="panel">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_row(form.shippingName) }}
                    {{ form_row(form.shippingAddress) }}
                    <div class="row">
                        <div class="col-sm-4">{{ form_row(form.shippingPostalCode) }}</div>
                        <div class="col-sm-8">{{ form_row(form.shippingCity) }}</div>
                    </div>
                    {{ form_row(form.shippingCountry) }}
                    <button class="btn btn-primary btn-lg w-100 mt-2">Continuer vers le paiement</button>
                {{ form_end(form) }}
            </div>
        </div>
        <div class="col-lg-5">
            <div class="cartouche">
                <div class="cartouche-head"><span>Votre commande</span><span>{{ lines|length }} ligne{{ lines|length > 1 ? 's' }}</span></div>
                <dl>
                    {% for line in lines %}
                        <dt>{{ line.quantity }} ×</dt><dd class="d-flex justify-content-between gap-2"><span>{{ line.product.name }}</span><span class="text-nowrap">{{ line.totalCents|price }}</span></dd>
                    {% endfor %}
                    <dt>Total</dt><dd class="text-end fw-bold fs-5">{{ total|price }}</dd>
                </dl>
            </div>
            <p class="small text-soft mt-3">Les figurines sont réservées dès que vous validez cette étape.</p>
        </div>
    </div>
{% endblock %}
