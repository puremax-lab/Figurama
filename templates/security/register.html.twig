{% extends 'base.html.twig' %}

{% block title %}{{ 'Inscription'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <p class="eyebrow mb-2">{{ 'Nouveau client'|trans }}</p>
            <h1 class="mb-4">{{ 'Inscription'|trans }}</h1>
            <div class="panel">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.firstName) }}</div>
                        <div class="col-sm-6">{{ form_row(form.lastName) }}</div>
                    </div>
                    {{ form_row(form.email) }}
                    {{ form_row(form.plainPassword) }}
                    <button class="btn btn-primary w-100 mt-2">{{ 'Créer mon compte'|trans }}</button>
                {{ form_end(form) }}
            </div>
            <p class="mt-3">{{ 'Déjà inscrit ?'|trans }} <a href="{{ path('app_login') }}">{{ 'Connexion'|trans }}</a></p>
        </div>
    </div>
{% endblock %}
