{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <p class="eyebrow mb-2">Espace client</p>
            <h1 class="mb-4">Connexion</h1>
            <div class="panel">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" name="email" value="{{ last_username }}" class="form-control" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100">Se connecter</button>
                </form>
            </div>
            <p class="small text-soft mt-3">Démo : <span class="fw-medium">client@figurama.test</span> ou <span class="fw-medium">admin@figurama.test</span>, mot de passe <span class="fw-medium">password</span>.</p>
            <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Inscription</a></p>
        </div>
    </div>
{% endblock %}
