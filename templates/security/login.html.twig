{% extends 'base.html.twig' %}

{% block title %}{{ 'Connexion'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <p class="eyebrow mb-2">{{ 'Accès client'|trans }}</p>
            <h1 class="mb-4">{{ 'Connexion'|trans }}</h1>
            <div class="panel">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label for="email" class="form-label">{{ 'Email'|trans }}</label>
                        <input type="email" id="email" name="email" value="{{ last_username }}" class="form-control" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">{{ 'Mot de passe'|trans }}</label>
                        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100">{{ 'Se connecter'|trans }}</button>
                </form>
            </div>
            <p class="small text-muted-blue mt-3">{{ 'Démo : %client% ou %admin%, mot de passe %password%.'|trans({'%client%': '<span class="text-white">client@figurama.test</span>', '%admin%': '<span class="text-white">admin@figurama.test</span>', '%password%': '<span class="text-white">password</span>'})|raw }}</p>
            <p>{{ 'Pas encore de compte ?'|trans }} <a href="{{ path('app_register') }}">{{ 'Inscription'|trans }}</a></p>
        </div>
    </div>
{% endblock %}
