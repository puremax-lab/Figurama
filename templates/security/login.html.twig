{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <h1 class="text-center">Connexion</h1>
            <p class="text-center text-body-secondary small">Comptes de démo : <strong>client@figurama.test</strong> ou <strong>admin@figurama.test</strong>, mot de passe <strong>password</strong></p>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}
                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" id="email" name="email" value="{{ last_username }}" class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Mot de passe</label>
                            <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button class="btn btn-primary w-100">Se connecter</button>
                    </form>
                </div>
            </div>
            <p class="text-center mt-3">Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a></p>
        </div>
    </div>
{% endblock %}
