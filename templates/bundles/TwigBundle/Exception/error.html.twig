{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <p class="display-1 fw-bold text-primary">{{ status_code }}</p>
        <h1 class="h3">
            {% if status_code == 404 %}Page introuvable
            {% elseif status_code == 403 %}Accès refusé
            {% else %}Une erreur est survenue{% endif %}
        </h1>
        <p class="text-body-secondary">{{ status_code == 404 ? 'Cette page n\'existe pas ou n\'est plus disponible.' : 'Réessayez dans un instant.' }}</p>
        <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a>
    </div>
{% endblock %}
