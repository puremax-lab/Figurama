{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <div class="text-center py-5 position-relative">
        <p class="display" style="font-size: clamp(5rem, 20vw, 10rem); line-height: 1">{{ status_code }}</p>
        <p class="mb-4"><span class="status status-pending">
            {% if status_code == 404 %}Page introuvable{% elseif status_code == 403 %}Accès refusé{% else %}Erreur{% endif %}
        </span></p>
        <p class="text-soft">{{ status_code == 404 ? 'Cette page n\'existe pas ou a été retirée de la boutique.' : 'Réessayez dans un instant.' }}</p>
        <a href="{{ path('app_home') }}" class="btn btn-primary mt-2">Retour à l'accueil</a>
    </div>
{% endblock %}
