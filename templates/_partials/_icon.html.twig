{# Thin line icons, drawn inline so they follow the text colour #}
<svg class="icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {% if name == 'brush' %}
        <path d="M18.4 2.6a2 2 0 0 1 2.9 2.9L12 14.8l-2.9-2.9 9.3-9.3z"/><path d="M9.1 11.9c-1.6 0-3.1 1.3-3.1 3 0 1.8-1.3 3.3-3 3.5 1 1.2 2.5 1.9 4.2 1.9 2.8 0 4.8-2.1 4.8-4.6"/>
    {% elseif name == 'truck' %}
        <path d="M1 4h13v11H1z"/><path d="M14 8h4l4 4v3h-8z"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
    {% elseif name == 'lock' %}
        <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {% elseif name == 'return' %}
        <path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>
    {% elseif name == 'gift' %}
        <rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13"/><path d="M12 8S10.5 3 8 3a2.5 2.5 0 0 0 0 5M12 8s1.5-5 4-5a2.5 2.5 0 0 1 0 5"/>
    {% endif %}
</svg>
