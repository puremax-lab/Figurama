<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th class="ps-3">{{ 'Pièce'|trans }}</th><th class="text-end">{{ 'Prix'|trans }}</th><th class="text-end">{{ 'Qté'|trans }}</th><th class="text-end pe-3">{{ 'Montant'|trans }}</th></tr></thead>
                    <tbody>
                        {% for item in order.items %}
                            <tr>
                                <td class="ps-3">{{ item.productName|trans({}, 'catalogue') }}</td>
                                <td class="text-end text-nowrap">{{ item.unitPriceCents|price }}</td>
                                <td class="text-end">{{ item.quantity }}</td>
                                <td class="text-end pe-3 text-nowrap">{{ item.totalCents|price }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">{{ 'Total'|trans }}</th><th class="text-end pe-3 text-nowrap">{{ order.totalCents|price }}</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cartouche">
            <div class="cartouche-head"><span>{{ 'Expédition'|trans }}</span><span>{{ order.shippingCountry }}</span></div>
            <dl>
                <dt>{{ 'Nom'|trans }}</dt><dd>{{ order.shippingName }}</dd>
                <dt>{{ 'Adresse'|trans }}</dt><dd>{{ order.shippingAddress }}<br>{{ order.shippingPostalCode }} {{ order.shippingCity }}<br>{{ country_name(order.shippingCountry) }}</dd>
                <dt>{{ 'Commandée'|trans }}</dt><dd>{{ order.createdAt|format_datetime('medium', 'short', locale: app.request.locale) }}</dd>
                <dt>{{ 'Payée'|trans }}</dt><dd>{{ order.paidAt ? order.paidAt|format_datetime('medium', 'short', locale: app.request.locale) : '—' }}</dd>
            </dl>
        </div>
    </div>
</div>
