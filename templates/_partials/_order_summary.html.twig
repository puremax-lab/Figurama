<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Article</th><th class="text-end">Prix</th><th class="text-end">Qté</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        {% for item in order.items %}
                            <tr>
                                <td>{{ item.productName }}</td>
                                <td class="text-end text-nowrap">{{ item.unitPriceCents|price }}</td>
                                <td class="text-end">{{ item.quantity }}</td>
                                <td class="text-end text-nowrap">{{ item.totalCents|price }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end text-nowrap">{{ order.totalCents|price }}</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-body-secondary">Livraison</h2>
                <address class="mb-3">
                    {{ order.shippingName }}<br>
                    {{ order.shippingAddress }}<br>
                    {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                    {{ country_name(order.shippingCountry) }}
                </address>
                <h2 class="h6 text-uppercase text-body-secondary">Dates</h2>
                <p class="mb-0 small">
                    Commandée le {{ order.createdAt|format_datetime('long', 'short', locale: 'fr') }}
                    {% if order.paidAt %}<br>Payée le {{ order.paidAt|format_datetime('long', 'short', locale: 'fr') }}{% endif %}
                </p>
            </div>
        </div>
    </div>
</div>
