<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th class="ps-3">Pièce</th><th class="text-end">Prix</th><th class="text-end">Qté</th><th class="text-end pe-3">Montant</th></tr></thead>
                    <tbody>
                        {% for item in order.items %}
                            <tr>
                                <td class="ps-3">{{ item.productName }}</td>
                                <td class="text-end text-nowrap">{{ item.unitPriceCents|price }}</td>
                                <td class="text-end">{{ item.quantity }}</td>
                                <td class="text-end pe-3 text-nowrap">{{ item.totalCents|price }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end pe-3 text-nowrap">{{ order.totalCents|price }}</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cartouche">
            <div class="cartouche-head"><span>Expédition</span><span>{{ order.shippingCountry }}</span></div>
            <dl>
                <dt>Nom</dt><dd>{{ order.shippingName }}</dd>
                <dt>Adresse</dt><dd>{{ order.shippingAddress }}<br>{{ order.shippingPostalCode }} {{ order.shippingCity }}<br>{{ country_name(order.shippingCountry) }}</dd>
                <dt>Commandée</dt><dd>{{ order.createdAt|format_datetime('medium', 'short', locale: 'fr') }}</dd>
                <dt>Payée</dt><dd>{{ order.paidAt ? order.paidAt|format_datetime('medium', 'short', locale: 'fr') : '—' }}</dd>
            </dl>
        </div>
    </div>
</div>
