<article class="plate">
    <div class="figure-photo">
        <img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy" width="600" height="750">
        {% if product.stock == 0 %}<span class="stamp">Épuisé</span>{% endif %}
    </div>
    <p class="plate-category">{{ product.category.name }}</p>
    <h3 class="plate-title"><a href="{{ path('app_product', {slug: product.slug}) }}" class="stretched-link">{{ product.name }}</a></h3>
    <div class="plate-meta">
        <span class="price">{{ product.priceCents|price }}</span>
        {% if product.lowStock %}<span class="stock-note">Plus que {{ product.stock }}</span>{% endif %}
    </div>
</article>
