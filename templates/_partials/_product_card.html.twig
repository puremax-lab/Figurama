{% set stats = rating(product) %}
<article class="plate">
    <span class="sticker">{{ product.priceCents|price }}</span>
    <header class="plate-head"><span>{{ product.reference }}</span></header>
    <div class="figure-photo">
        <img src="{{ product.imageUrl }}" alt="{{ product.name|trans({}, 'catalogue') }}" loading="lazy" width="600" height="600">
        <div class="dim-v" aria-hidden="true"><span>{{ product.heightCm }} cm</span></div>
        {% if product.stock == 0 %}<span class="stamp">{{ 'Épuisé'|trans }}</span>{% endif %}
        {% if product.lowStock %}<span class="sticker sticker-white plate-low">{{ 'Plus que %count%'|trans({'%count%': product.stock}) }}</span>{% endif %}
    </div>
    <h3 class="plate-title"><a href="{{ path('app_product', {slug: product.slug}) }}" class="stretched-link">{{ product.name|trans({}, 'catalogue') }}</a></h3>
    <p class="plate-meta">{{ 'Éch. %scale%'|trans({'%scale%': product.scale}) }} · {{ product.material|trans({}, 'catalogue') }}</p>
    <div class="plate-foot">
        {% if stats %}
            <span class="plate-rating">
                <span class="stars" aria-hidden="true">{{ stats.average|stars }}</span>
                <span class="visually-hidden">{{ 'Note %rating% sur 5,'|trans({'%rating%': stats.average|decimal}) }}</span>
                ({{ stats.count }})
            </span>
        {% else %}
            <span class="plate-rating text-muted-blue">{{ 'Nouveau'|trans }}</span>
        {% endif %}
        {% if product.available %}
            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" class="quick-add" data-cart-add>
                <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                <button class="btn btn-primary btn-sm" aria-label="{{ 'Ajouter %name% au bon de commande'|trans({'%name%': product.name|trans({}, 'catalogue')}) }}">{{ '+ Ajouter'|trans }}</button>
            </form>
        {% endif %}
    </div>
</article>
