<div class="card product-card h-100 shadow-sm">
    <div class="p-2">
        <div class="product-visual" style="background: {{ product.color }}" aria-hidden="true">{{ product.icon }}</div>
    </div>
    <div class="card-body pt-2 d-flex flex-column">
        <span class="small text-body-secondary">{{ product.category.name }}</span>
        <h3 class="h6 mb-2"><a href="{{ path('app_product', {slug: product.slug}) }}" class="stretched-link">{{ product.name }}</a></h3>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="price">{{ product.priceCents|price }}</span>
            {% if product.stock == 0 %}
                <span class="badge text-bg-secondary">Épuisé</span>
            {% elseif product.lowStock %}
                <span class="badge text-bg-warning">Plus que {{ product.stock }}</span>
            {% endif %}
        </div>
    </div>
</div>
