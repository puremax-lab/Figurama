<article class="plate">
    <span class="sticker">{{ product.priceCents|price }}</span>
    <header class="plate-head"><span>{{ product.reference }}</span></header>
    <div class="figure-photo">
        <img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy" width="600" height="600">
        <div class="dim-v" aria-hidden="true"><span>{{ product.heightCm }} cm</span></div>
        {% if product.stock == 0 %}<span class="stamp">Épuisé</span>{% endif %}
    </div>
    {% if product.lowStock %}<span class="sticker sticker-white plate-low">Plus que {{ product.stock }}</span>{% endif %}
    <h3 class="plate-title"><a href="{{ path('app_product', {slug: product.slug}) }}" class="stretched-link">{{ product.name }}</a></h3>
    <p class="plate-meta">Éch. {{ product.scale }} · {{ product.material }}</p>
</article>
